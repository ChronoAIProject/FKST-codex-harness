# Copy this file to fkst.env and set host facts for local runs.
FKST_FRAMEWORK_BIN=fkst-framework
FKST_RUNTIME_ROOT=.fkst/runtime
FKST_CANDIDATE_PREFIX=candidate
FKST_CANDIDATE_FROM_SEP=__from__

# --- codex harness two-plane config ---
# Appended by Task C (spec §4). The block above is the as-emitted scaffold template;
# everything below is the codex harness two-plane configuration. Copy this file to
# .fkst/env (per spec §4) or fkst.env and fill in per-device values. Keep
# FKST_GITHUB_WRITE UNSET for dry-run posture (no foreign/fork writes).

# targets - keep the two "upstreams" distinct
FKST_CONTRIB_TARGET=openai/codex            # foreign: read + gated propose
FKST_GITHUB_REPO=ChronoAIProject/codex      # owned fork: write (branches/PRs)
FKST_FORK_LOCAL_PATH=/abs/path/to/codex     # local fork clone for worktrees
FKST_GITHUB_BOT_LOGIN=<device-bot>          # device identity (= gh login)
FKST_FORK_SYNC_BRANCH=main                  # ff openai/codex main -> fork main

# gate policy
FKST_PROPOSE_REQUIRE_INVITE=1               # no upstream PR without a recorded invite
FKST_PROPOSE_DAILY_CAP=3                    # volume cap on new upstream engagements
FKST_PROPOSE_DISCLOSE_AI=1                  # AI disclosure on every upstream post

# engine bin (local dev): absolute path to the built fkst-framework
BIN=/abs/path/to/FKST-substrate/target/debug/fkst-framework
